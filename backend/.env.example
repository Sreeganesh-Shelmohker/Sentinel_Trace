# .env.example - copy this to .env and fill in your credentials.
#
# Moss (semantic search / guardrail index)
# Get your project credentials at https://moss.dev
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here

# Google Gemini (LLM backend)
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
